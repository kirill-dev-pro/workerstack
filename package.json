{
  "name": "workerstack-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --parallel --filter './packages/*' test && bun test scripts/",
    "test:workers": "bun scripts/workers-integration.ts",
    "test:orpc-contract": "bun test packages/workerstack/src/api/openapi-client-generation.test.ts && bunx tsc --noEmit -p packages/workerstack/tsconfig.json",
    "test:boundaries": "bun test scripts/dependency-boundaries.test.ts",
    "test:bundles": "bun test scripts/bundle-boundaries.test.ts",
    "typecheck": "bun run --parallel --filter './packages/*' typecheck",
    "typecheck:examples": "bun run build && bunx tsc --noEmit -p examples/agent-chat/tsconfig.json && bunx tsc --noEmit -p examples/todo-solid-native/tsconfig.json && bunx tsc --noEmit -p examples/ssr-probe/tsconfig.json",
    "typecheck:all": "bun run typecheck && bun run typecheck:examples",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "fix": "bun run lint && bun run format",
    "build": "bun scripts/build-package.ts workerstack",
    "prepare": "bun scripts/prepare.ts",
    "verify:consumer": "bun scripts/verify-consumer.ts",
    "dev": "bun run --cwd examples/ssr-probe dev"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.0",
    "esbuild": "^0.28.2",
    "nodemailer": "^9.0.3",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "@libsql/client": "0.14.0",
    "@tanstack/db": "0.6.16",
    "@tanstack/query-core": "^5.101.1",
    "@tanstack/query-db-collection": "1.1.0",
    "@tanstack/react-db": "0.1.94",
    "@tanstack/react-query": "^5.101.1",
    "drizzle-orm": "0.45.2"
  }
}
